# ==============================================================================
# VIYO Environment Variables Template (.env.example)
# Copy this file to .env in backend/ and web/ and populate with your credentials
# ==============================================================================

# Application & Security
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=generate-a-secure-random-64-char-string-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./viyo.db
# Supabase / PostgreSQL Production:
# DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# LiveKit Cloud WebRTC SFU
LIVEKIT_URL=wss://<YOUR_LIVEKIT_PROJECT>.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Firebase & Push Notifications
FIREBASE_PROJECT_ID=viyo-c3b64
FIREBASE_CREDENTIALS_PATH=
VAPID_PUBLIC_KEY=your_web_push_vapid_public_key

# Web Client Environment (.env in web/ directory)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
VITE_LIVEKIT_URL=wss://<YOUR_LIVEKIT_PROJECT>.livekit.cloud
VITE_VAPID_PUBLIC_KEY=your_web_push_vapid_public_key
